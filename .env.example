# Phantom SOAR environment template
# =================================
# Copy to .env and fill in the values:   cp .env.example .env
#
# - docker compose reads .env for ${VAR} substitution in docker-compose.yml.
#   Variables marked REQUIRED have no default; compose refuses to start without them.
# - scripts/dev.sh, run_backend.bat and run_frontend.bat also load .env if it exists.
# - Never commit .env. Generate every secret yourself, for example:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#   token_urlsafe output contains only [A-Za-z0-9_-], so it is also safe inside URLs
#   (the Postgres and Redis passwords end up in DATABASE_URL / REDIS_URL).
#
# Integration settings below can also be entered on the Configuration page; a value
# saved there takes precedence over the environment variable.

# -----------------------------------------------------------------------------
# Secrets (REQUIRED for docker compose)
# -----------------------------------------------------------------------------
# Postgres password for the bundled database container.
POSTGRES_PASSWORD=
# Password for the bundled Redis broker (Celery queue).
REDIS_PASSWORD=
# HMAC key that signs login JWTs. Rotating it logs everyone out. If unset outside
# Docker, the backend generates a random per-process secret and logs a warning.
PHANTOM_JWT_SECRET=
# Initial password for the bootstrap admin account "abunemah" (used only when the
# account is created or still has the legacy default password). Use a long passphrase.
# If unset outside Docker, a random password is generated and logged once at WARNING.
PHANTOM_BOOTSTRAP_ADMIN_PASSWORD=
# Shared secret that SIEM / EDR / XDR senders put in the X-Phantom-Ingest-Token header
# when calling /api/webhooks/*. Webhook ingestion is disabled (503) while it is unset.
PHANTOM_INGEST_TOKEN=

# -----------------------------------------------------------------------------
# Core backend
# -----------------------------------------------------------------------------
# development | production | test (docker compose defaults to production).
# PHANTOM_ENV=development
# Login session lifetime in minutes (default 720 = 12 hours).
PHANTOM_JWT_EXPIRE_MINUTES=720
# Comma-separated browser origins allowed to call the API (never "*").
# Add http://<host-ip>:3000 when the UI is opened from another machine.
PHANTOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database, broker and storage (only needed when running OUTSIDE docker compose;
# docker-compose.yml wires these to the bundled Postgres / Redis itself)
# -----------------------------------------------------------------------------
# Postgres user / database name for the bundled container (defaults shown).
# POSTGRES_USER=phantom
# POSTGRES_DB=phantom_soar
# Leave DATABASE_URL unset to use the local SQLite file <repo>/phantom_soar.db.
# When it is set and the database is unreachable, startup fails instead of silently
# switching to SQLite, unless PHANTOM_ALLOW_SQLITE_FALLBACK=true.
# DATABASE_URL=postgresql://phantom:<password>@localhost:5432/phantom_soar
# PHANTOM_ALLOW_SQLITE_FALLBACK=false
# Celery broker. When it is unreachable, alerts are processed synchronously in the API.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Where incident / audit PDF reports are written (default backend/reports).
# REPORTS_DIR=./backend/reports

# -----------------------------------------------------------------------------
# Orchestration and AI-agent guardrails (empty = application default)
# -----------------------------------------------------------------------------
# Simulation mode (default true): unconfigured connectors record clearly labelled
# SIMULATED actions and lab threat-intel fixtures are enabled. Set false for real use;
# unconfigured actions are then recorded as skipped.
PHANTOM_SIMULATION_MODE=
# Human-on-the-loop autonomous containment for HOTL playbooks (default true).
PHANTOM_HOTL_ENABLED=
# Comma-separated hosts / users / IPs that automated actions (playbooks, agent) must never touch.
PHANTOM_PROTECTED_HOSTS=
PHANTOM_PROTECTED_USERS=
PHANTOM_PROTECTED_IPS=
# Minimum agent confidence (0-1) for any autonomous agent action (default 0.85).
PHANTOM_AGENT_MIN_CONFIDENCE=
# recommend_only (default) | low_impact | policy
PHANTOM_AGENT_AUTONOMY=

# -----------------------------------------------------------------------------
# Threat intelligence providers (optional; unconfigured providers report "not_configured")
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
THREATFOX_API_KEY=
NVD_API_KEY=

# -----------------------------------------------------------------------------
# Wazuh manager API (optional)
# -----------------------------------------------------------------------------
# e.g. https://wazuh-manager:55000
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Verify the manager's TLS certificate (default true).
WAZUH_VERIFY_TLS=

# -----------------------------------------------------------------------------
# Identity provider (optional): Okta
# -----------------------------------------------------------------------------
# e.g. your-org.okta.com
OKTA_DOMAIN=
OKTA_API_TOKEN=

# -----------------------------------------------------------------------------
# ITSM / notifications (optional)
# -----------------------------------------------------------------------------
# e.g. https://your-org.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Frontend and published ports
# -----------------------------------------------------------------------------
# API URL as seen by the user's BROWSER. It is baked into the frontend bundle at build
# time, so rebuild after changing it (docker compose build frontend). Do not use the
# internal compose hostname http://backend:8000 here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host interface docker compose publishes ports 8000 / 3000 on (default 127.0.0.1).
# Use 0.0.0.0 when Wazuh or other machines must reach the API / UI.
# PHANTOM_PUBLISH_HOST=127.0.0.1
