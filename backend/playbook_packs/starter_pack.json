    {
      "name": "Malware from Removable Media",
      "target_threat": "Malware",
      "execution_mode": "HITL",
      "is_active": false,
      "description": "Own summary for malware that arrives on a USB or other removable drive: stop the process, quarantine the file, isolate with approval, and notify the owner's team. Source framework: CERT-SG IRM style malware handling and NIST SP 800-61 containment.",
      "source_framework": "CERT-SG IRM style / NIST SP 800-61",
      "workflow_logic": {
        "mitre_id": "T1091",
        "mitre_tactic": "Initial Access",
        "mitre_technique": "Replication Through Removable Media",
        "picerl_phase": "Containment & Eradication",
        "keywords": [
          "usb",
          "removable media",
          "autorun",
          "usb malware",
          "external drive"
        ],
        "triggers": [
          "usb_autorun_execution",
          "removable_media_executable_written"
        ],
        "steps": [
          {
            "action": "terminate_process",
            "connector": "edr"
          },
          {
            "action": "quarantine_file",
            "connector": "edr"
          },
          {
            "action": "await_analyst_approval",
            "role": "SOC Analyst L2"
          },
          {
            "action": "isolate_endpoint",
            "connector": "edr"
          },
          {
            "action": "send_notification",
            "connector": "itsm",
