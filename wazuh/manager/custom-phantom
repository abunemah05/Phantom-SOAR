#!/usr/bin/env python3
"""Wazuh integratord -> Phantom SOAR alert forwarder.

Install on the Wazuh MANAGER:
    install -o root -g wazuh -m 750 custom-phantom /var/ossec/integrations/custom-phantom
then add the <integration> block from wazuh/ossec-manager-snippets.xml and restart wazuh-manager.

Wazuh calls:  custom-phantom <alert_json_file> <api_key> <hook_url> [debug]
  api_key  = a Phantom ingest token (Accounts page)
  hook_url = https://<your-phantom-host>/api/webhooks/wazuh

Standard library only. Exit code 0 = delivered; non-zero makes integratord log the failure.
"""
import json
import ssl
import sys
import time
import urllib.error
import urllib.request

TIMEOUT = 20
ATTEMPTS = 3


def main(argv):
    if len(argv) < 4:
        print("usage: custom-phantom <alert_file> <ingest_token> <hook_url>", file=sys.stderr)
        return 2
    alert_file, token, hook_url = argv[1], argv[2], argv[3]
    if not hook_url.lower().startswith(("https://", "http://")):
        print("hook_url must start with https:// (or http:// for a lab)", file=sys.stderr)
        return 2
    with open(alert_file, "r", encoding="utf-8") as handle:
        alert = json.load(handle)
    body = json.dumps(alert).encode("utf-8")
    request = urllib.request.Request(
        hook_url, data=body, method="POST",
        headers={"Content-Type": "application/json", "X-Phantom-Ingest-Token": token},
    )
    context = ssl.create_default_context()  # certificate verification stays ON
    last_error = "unknown error"
    for attempt in range(1, ATTEMPTS + 1):
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT, context=context if hook_url.lower().startswith("https") else None) as response:
                if 200 <= response.status < 300:
                    return 0
                last_error = f"HTTP {response.status}"
        except urllib.error.HTTPError as exc:
            last_error = f"HTTP {exc.code}"
            if exc.code in (400, 401, 403, 404, 413, 422):  # retrying cannot help
                break
        except (urllib.error.URLError, OSError) as exc:
            last_error = str(exc)[:200]
        time.sleep(2 * attempt)
    print(f"custom-phantom: delivery failed: {last_error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
