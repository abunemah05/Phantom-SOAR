#!/usr/bin/env python3
"""Wazuh integratord -> Phantom SOAR alert forwarder.

Install on the Wazuh MANAGER:
    install -o root -g wazuh -m 750 custom-phantom /var/ossec/integrations/custom-phantom
then add the <integration> block from wazuh/ossec-manager-snippets.xml and restart wazuh-manager.

Wazuh calls:  custom-phantom <alert_json_file> <api_key> <hook_url> [debug]
  api_key  = a Phantom ingest token (Accounts page)
  hook_url = https://<your-phantom-host>/api/webhooks/wazuh

Standard library only. Exit code 0 = delivered; non-zero makes integratord log the failure.
"""
import json
import ssl
import sys
import time
import urllib.error
import urllib.request

TIMEOUT = 10
ATTEMPTS = 2
# NOTE: there is no local spool. If Phantom stays unreachable for both attempts the alert is not forwarded;
# integratord logs the failure in /var/ossec/logs/integrations.log. Keep this short so integratord is not stalled.


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect would turn the POST into a GET and re-send the token header elsewhere: fail loudly instead."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, f"redirect to {newurl} refused", headers, fp)


def main(argv):
    if len(argv) < 4:
        print("usage: custom-phantom <alert_file> <ingest_token> <hook_url>", file=sys.stderr)
        return 2
    alert_file, token, hook_url = argv[1], argv[2], argv[3]
    if not hook_url.lower().startswith(("https://", "http://")):
        print("hook_url must start with https:// (or http:// for a lab)", file=sys.stderr)
        return 2
    if hook_url.lower().startswith("http://"):
        print("custom-phantom: WARNING: http:// sends the ingest token unencrypted; use https:// in production", file=sys.stderr)
    with open(alert_file, "r", encoding="utf-8") as handle:
        alert = json.load(handle)
    body = json.dumps(alert).encode("utf-8")
    request = urllib.request.Request(
        hook_url, data=body, method="POST",
        headers={"Content-Type": "application/json", "X-Phantom-Ingest-Token": token},
    )
    # Certificate verification stays ON. For a private CA set SSL_CERT_FILE in integratord's environment.
    opener = urllib.request.build_opener(_NoRedirect, urllib.request.HTTPSHandler(context=ssl.create_default_context()))
    last_error = "unknown error"
    for attempt in range(1, ATTEMPTS + 1):
        try:
            with opener.open(request, timeout=TIMEOUT) as response:
                if 200 <= response.status < 300:
                    return 0
                last_error = f"HTTP {response.status}"
        except urllib.error.HTTPError as exc:
            last_error = f"HTTP {exc.code}"
            if 300 <= exc.code < 500 and exc.code != 429:  # redirects and client errors: retrying cannot help
                break
        except (urllib.error.URLError, OSError) as exc:
            last_error = str(exc)[:200]
        if attempt < ATTEMPTS:
            time.sleep(2)
    print(f"custom-phantom: delivery failed: {last_error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
